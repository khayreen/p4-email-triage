# Copy to .env and fill in. Never commit .env.

# Which LLM to use: groq | gemini | openrouter | ollama | baseline (no LLM)
LLM_PROVIDER=groq

# Only the key for your chosen provider is needed. Ollama needs none.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the provider's default model. Free-tier model names change,
# so if a call returns "model not found", check the provider's model list.
# LLM_MODEL=

# Optional: require this key in the X-API-Key header on every API call.
# SERVICE_API_KEY=

# Optional: results below this confidence go to human review (default 0.75).
# REVIEW_THRESHOLD=0.75
